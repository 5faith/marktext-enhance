{
  "name": "marktext",
  "version": "1.0.0",
  "homepage": "https://marktext.app/",
  "description": "Next generation markdown editor - trigger build",
  "license": "MIT",
  "main": "./dist/electron/main.js",
  "scripts": {
    "release": "echo 'Please run \"build\" or \"release:{linux,mac,win}\"' && exit 1",
    "release:linux": "vite build && electron-builder --linux",
    "release:mac": "vite build && electron-builder --mac",
    "release:win": "vite build && electron-builder --win",
    "build": "vite build && electron-builder",
    "build:bin": "vite build && electron-builder --dir",
    "build:clean": "rimraf dist",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "dev": "vite",
    "e2e": "vite build && cross-env MARKTEXT_EXIT_ON_ERROR=1 playwright test -c test/e2e/playwright.config.js test/e2e",
    "lint": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter src test",
    "lint:fix": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter --fix src test",
    "postinstall": "node .electron-vue/postinstall.js && cd node_modules/@marktext/file-icons && npm install --no-save && npx rollup -c --environment BUILD:production && cd ../.. && yarn run lint:fix",
    "test": "yarn run unit && yarn run e2e",
    "test:specs": "node -r esm test/specs/commonMark/run.spec.js && node -r esm test/specs/gfm/run.spec.js",
    "unit": "cross-env NODE_ENV=test vitest run",
    "preinstall": "node .electron-vue/preinstall.js",
    "build:muya": "cd src/muya && vite build",
    "release:muya": "yarn run build:muya && cd src/muya && yarn publish",
    "gen-third-party": "node tools/generateThirdPartyLicense.js",
    "validate-licenses": "node tools/validateLicenses.js",
    "deobfuscateStackTrace": "node tools/deobfuscateStackTrace.js"
  },
